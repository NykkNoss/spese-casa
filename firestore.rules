rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.uid in [
          "lOt2a3kK2lees091fYHSTdLo68J2",
          "UID_DELLA_TUA_COMPAGNA"
        ];
    }

    match /home_expenses/{ledgerId}/items/{itemId} {
      allow read, create, update, delete: if isAllowedUser();
    }

    match /home_expenses/{ledgerId}/settings/{settingId} {
      allow read, create, update, delete: if isAllowedUser();
    }
  }
}
